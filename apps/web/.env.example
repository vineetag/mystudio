# App
NEXT_PUBLIC_SITE_URL=https://appcrafter.studio

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string — used by scripts/setup-db.sh to run migrations
# Get it from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AI
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to view /admin
ADMIN_EMAILS=

# Contact form (Resend) — uses a domain alias so your real inbox never appears
# anywhere in code or env. Point the alias at your real inbox via email
# forwarding (Cloudflare Email Routing, ImprovMX, or your registrar).
RESEND_API_KEY=
# Alias that receives submissions; forward it to your real inbox
CONTACT_TO=hello@appcrafter.studio
# Verified Resend sender on your domain (must match a verified domain)
CONTACT_FROM=AppCrafter Studio <hello@appcrafter.studio>
