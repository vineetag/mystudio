# App
# MUST be the canonical domain (apex 308-redirects to www). OAuth pins its
# callback to this in production — a mismatch splits the auth cookie across
# apex/www and drops the session.
# Also drives the <link rel="canonical"> tag and robots.ts `host`: the app is
# also served on zippytales.appcrafter.studio, and only this host gets indexed.
# To move the canonical host, change this AND the Supabase Auth Site URL.
NEXT_PUBLIC_SITE_URL=https://www.zippytales.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string — used by scripts/setup-db.sh to run migrations
# Get it from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=
# Secret guarding the cleanup route (/api/cron/cleanup-anon). Sent as
# `Authorization: Bearer <CRON_SECRET>` by the GitHub Actions weekly workflow.
# Must match the CRON_SECRET GitHub repo secret. Generate: openssl rand -hex 32
CRON_SECRET=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AI
ANTHROPIC_API_KEY=
# Per-user stories per day (default 1)
DAILY_STORY_LIMIT=5
# Hard monthly spend ceiling in USD across all users (default 20)
ANTHROPIC_MONTHLY_BUDGET_USD=20

# Comma-separated emails allowed to view /admin
ADMIN_EMAILS=
