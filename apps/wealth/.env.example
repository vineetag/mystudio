# App
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase (mystudio project — all OneFolio tables are pt_-prefixed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub quote API (server-only). Free tier: https://finnhub.io
FINNHUB_API_KEY=

# The single email allowed to sign in (LIVE mode). Everyone else gets demo mode.
OWNER_EMAIL=

# Auth email (magic link) is relayed through Resend as Supabase *custom SMTP* —
# NOT via env vars here. Configured in the Supabase dashboard:
#   Authentication > Emails > SMTP Settings
#     host smtp.resend.com, port 465, user "resend",
#     password = Resend API key, sender login@getonefolio.app (verified domain)
# App code sends no mail — signInWithOtp() just hands off to Supabase.
# Dev bypass: `node scripts/magic-link.mjs` (no email, uses service role key).

# SnapTrade brokerage sync (server-only, optional — connect UI hides without them)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Required with personal keys (client id starts with PERS-): those can't call
# registerUser — the single user is created at signup. Copy its id + secret
# from the SnapTrade dashboard. Leave empty for partner keys.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# Shared secret guarding /api/cron/snapshot (Vercel Cron sends it as a Bearer
# token). Any long random string: `openssl rand -hex 32`
CRON_SECRET=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
