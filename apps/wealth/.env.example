# App — local dev URL; production (Vercel) should be https://getonefolio.app
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Supabase (mystudio project — all OneFolio tables are pt_-prefixed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection URI for running migrations (Settings → Database → Connection string → URI)
DATABASE_URL=

# Finnhub quote API (server-only). Free tier: https://finnhub.io
FINNHUB_API_KEY=

# logo.dev — stock/company LOGO images (https://logo.dev). The by-ticker image
# endpoint resolves the correct logo (Apple for AAPL, etc). Publishable key
# (pk_...) is embedded in image URLs and therefore CLIENT-VISIBLE by design —
# that is how logo.dev image auth works, it is not a secret.
# (Company NAMES come from Finnhub's /stock/profile2, not logo.dev — its brand
# search is name-based and returns the wrong company for many tickers.)
NEXT_PUBLIC_LOGODEV_PUBLISHABLE_KEY=

# The single email allowed to sign in (LIVE mode). Everyone else gets demo mode.
OWNER_EMAIL=

# Auth email (magic link) is relayed through Resend as Supabase *custom SMTP* —
# NOT via env vars here. Configured in the Supabase dashboard (or Management API):
#   Authentication > Emails > SMTP Settings
#     host smtp.resend.com, port 587 (or 465), user "resend",
#     password = Resend API key, sender login@appcrafter.studio (verified domain)
# App code sends no mail — signInWithOtp() just hands off to Supabase.
# Dev bypass: `node scripts/magic-link.mjs` (no email, uses service role key).

# SnapTrade brokerage sync (server-only, optional — connect UI hides without them)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Required with personal keys (client id starts with PERS-): those can't call
# registerUser — the single user is created at signup. Copy its id + secret
# from the SnapTrade dashboard. Leave empty for partner keys.
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# SimpleFIN Bridge bank-balance sync (server-only, optional — cash section
# hides without it). This is the ACCESS URL from a one-time setup-token
# exchange, in the form https://user:pass@beta-bridge.simplefin.org/simplefin.
# It embeds Basic Auth credentials: treat it like a password. Never log it,
# never expose it to the client, never commit it. Exchange the setup token in
# a plain terminal (the token is single-use):
#   CLAIM_URL=$(echo "<SETUP_TOKEN>" | base64 --decode)
#   curl -X POST "$CLAIM_URL"
SIMPLEFIN_ACCESS_URL=

# Shared secret guarding /api/cron/snapshot (Vercel Cron sends it as a Bearer
# token). Any long random string: `openssl rand -hex 32`
CRON_SECRET=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
