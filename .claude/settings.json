{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-push-check.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-commit-dev.sh"
          }
        ]
      }
    ]
  }
}
