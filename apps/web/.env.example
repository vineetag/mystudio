# App
NEXT_PUBLIC_SITE_URL=https://appcrafter.studio

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string — used by scripts/setup-db.sh to run migrations
# Get it from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AI
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to view /admin
ADMIN_EMAILS=

# Contact form (Resend) — keeps your real inbox out of the codebase
RESEND_API_KEY=
# Inbox that receives contact-form submissions (your real address)
CONTACT_TO=
# Verified sender, e.g. "AppCrafter <contact@appcrafter.studio>"
CONTACT_FROM=
